# Person 1 - switch-hackathon-swarm
# Copy to .env and fill in. NEVER commit the real .env.

# Switch server API (Switch Console local server)
SWITCH_API_URL=http://localhost:49921

# Person 2 supervisor API. When reachable it handles experiments;
# when it is down, TWO REAL LOCAL AGENTS run instead (no mock).
SUPERVISOR_API_URL=http://localhost:3000

# The AI agent command each swarm agent runs. {prompt} is replaced by the
# agent's prompt. Default: opencode run {prompt}
# Examples:
#   SWARM_AGENT_CMD=opencode run {prompt}
#   SWARM_AGENT_CMD=opencode run --model opencode/gpt-5-nano {prompt}
# SWARM_AGENT_CMD=

# Max time one agent run may take before it is stopped (default 10 minutes)
# SWARM_AGENT_TIMEOUT_MS=600000

# Slash-command server (Option B: native /experiment in Mattermost)
PORT=4000
# Token Mattermost shows when you add the slash command integration (recommended)
MM_SLASH_TOKEN=
