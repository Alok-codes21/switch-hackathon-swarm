{
  "project": "switch-hackathon-swarm",
  "version": "1.1.0",
  "host": {
    "agent": "OpenCode",
    "agent_version": "1.18.25",
    "switch_console_version": "0.40.1",
    "switch_ports": {
      "gateway": 49920,
      "api": 49921,
      "mattermost": 49922,
      "postgres": 49923
    },
    "permissions": {
      "bypass_permissions": false,
      "switch_room_requires_approval_for": ["write", "bash", "execute"],
      "headless_agent_runs": {
        "edit": "allow",
        "webfetch": "allow",
        "bash": "deny by default; allow node, npm test, npm run, ls, dir, cat, type"
      }
    }
  },
  "swarm_contract": {
    "worktree_base_dir": ".worktrees",
    "agents": ["agent-a", "agent-b"],
    "request": ["experimentId", "problem", "agents"],
    "response": ["worktrees", "winner", "requiresHumanApproval"],
    "approval_required_for_merge": true
  }
}
